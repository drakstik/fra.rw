DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432
NODE_ENV=development
DB_SSL=false # single-host application
SWAGGER_DOCS_USER=
SWAGGER_DOCS_PASSWORD=<generate with: openssl rand -base64 24>
# Origins allowed to make state-changing requests (comma-separated).
# Required in production; in dev it defaults to http://localhost:8080,http://localhost:5173
ALLOWED_ORIGINS=